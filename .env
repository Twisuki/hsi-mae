# HSI-MAE 默认配置
# .env.local 会覆盖此文件，且不会被 git 提交

# 数据路径
DATA_PATH=data/synthetic_hsi.npy
LABELS_PATH=data/synthetic_hsi_gt.npy

# 模型参数
BANDS=200
ENCODER_DIM=256
ENCODER_LAYERS=4
MASK_RATIO=0.75
NUM_CLASSES=8

# 训练参数
EPOCHS=100
BATCH_SIZE=256
LR=0.001
WEIGHT_DECAY=0.0001
WARMUP_EPOCHS=10

# 路径与设备
ENCODER_PATH=checkpoints/final_encoder.pt
SAVE_DIR=checkpoints
DEVICE=cuda
NUM_WORKERS=4

# 其他
LOG_INTERVAL=10
SEED=42
FINETUNE_MODE=full
